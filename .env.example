# Copy to .env (git-ignored) or, better, load from your OS keychain at run time.
# Never commit real values. The notifier reads these from the environment only.

# iOS push via Bark: https://api.day.app/<device-key>
BARK_URL=
# Or an ntfy topic URL: https://ntfy.sh/<long-random-private-topic>
NTFY_URL=
